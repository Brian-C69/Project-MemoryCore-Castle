# Node / Vite
node_modules/
dist/
*.log
npm-debug.log*

# Rust / Tauri
src-tauri/target/
src-tauri/gen/
# Castle is a Windows desktop app; the mobile icon sets the icon tool also writes are not used
src-tauri/icons/android/
src-tauri/icons/ios/

# Secrets never live in the repo (keys are kept by Windows Credential Manager)
.env
.env.*
# the test memory carries a .env with FAKE keys on purpose
!src-tauri/tests/fixtures/**/.env

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Claude Code settings
.claude/

# Project Resources (local working notes - never commit)
Project Resources

# the dev Castle may run on the test memory; what it writes there (worlds made, the story room's
# notes, the appearance card) is never part of the fixture
src-tauri/tests/fixtures/memory-existing/adventures/
src-tauri/tests/fixtures/memory-existing/appearance/
src-tauri/tests/fixtures/memory-existing/worlds/

# release files made by scripts/release.ps1 or the release workflow
release-out/

#!/bin/sh
# castle-memory: the companion's door to the memory database.
# Starts Castle's own program with --memory; it answers and ends, no window.
# Long text goes through --file <path>, never on the command line.
if [ -z "${CASTLE_EXE:-}" ]; then
  echo "castle-memory: run this from a session Castle started (CASTLE_EXE is not set)." >&2
  exit 1
fi
exec "$CASTLE_EXE" --memory "$@"
